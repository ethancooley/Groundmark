{
  "manifest_version": 3,
  "name": "Groundmark",
  "short_name": "Groundmark",
  "version": "1.0.1",
  "description": "Checks each sentence of a Google AI Overview against the pages it cites, on your own computer, and shows you the evidence.",
  "minimum_chrome_version": "138",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "offscreen"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Groundmark",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.uk/search*",
        "https://www.google.ca/search*",
        "https://www.google.com.au/search*",
        "https://www.google.co.in/search*",
        "https://www.google.ie/search*",
        "https://www.google.co.nz/search*",
        "http://localhost:3000/lab*",
        "https://*.vercel.app/lab*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
